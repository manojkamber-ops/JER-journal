// Journal of Economic Research — portal database (Neon Postgres, connected through Vercel Storage).
// Accounts, sessions, saved articles and a copy of each form entry. Papers and form entries also live in Sanity.
// Vercel sets both variables when the database is connected to the project:
//   DATABASE_URL:          pooled connection, used by the site
//   DATABASE_URL_UNPOOLED: direct connection, used by `prisma db push` (run on every deploy by scripts/vercel-build.mjs)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  affiliation  String?
  passwordHash String
  createdAt    DateTime        @default(now())
  sessions     Session[]
  saved        SavedArticle[]
  submissions  Submission[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model Submission {
  id           String   @id @default(cuid())
  reference    String   @unique
  status       String   // "draft" | "submitted"
  userId       String?
  title        String
  articleType  String?
  wordCount    Int?
  abstract     String?
  keywords     String?
  jelCodes     String?
  authorName   String?
  authorEmail  String?
  orcid        String?
  affiliations String?
  coverLetter  String?
  fileName     String?
  fileSize     Int?
  storedFile   String?
  /// The manuscript itself when it could not be stored in Sanity or on disk (e.g. Vercel without a Sanity token)
  fileData     Bytes?
  fileType     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  organisation String?
  subject      String
  message      String
  createdAt    DateTime @default(now())
}

model AlertSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  topics    String   // comma-separated: "new-issue,cfp,news,citation:<articleId>"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
