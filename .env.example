# Neon Postgres "jer-journal-db" (Vercel → Storage). Vercel sets both on the project; for local work copy them from
# the database's Quickstart tab in Vercel. Secrets: keep out of git.
# Pooled connection, for the website:
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Direct connection, for `npx prisma db push`:
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# Sanity project "Journal of Economic Research" (imuzzo9u). Papers: public dataset "production" (read live, no
# token). Form entries: private dataset "forms". The write token is a secret: keep it in .env and in Vercel only.
SANITY_PROJECT_ID=imuzzo9u
SANITY_DATASET=production
SANITY_FORMS_DATASET=forms
SANITY_API_WRITE_TOKEN=
