# Supabase Postgres (Project Settings → Database → Connection string). Secrets: keep out of git.
# Transaction pooler (port 6543), for the website:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Session pooler or direct connection (port 5432), for `npx prisma db push`:
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Sanity (project "Journal of Economics"). The token is a secret: keep it in .env / .env.local and in
# Vercel → Settings → Environment Variables, never in git.
SANITY_PROJECT_ID=oy0g1kj5
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
